  (t * bh - y * bc) * (t * bh - y * bc) +
  (t * bi - z * bc) * (t * bi - z * bc) +
  (t * bj - aa * bc) * (t * bj - aa * bc) +
  (u * be - v * bd) * (u * be - v * bd) +
  (u * bf - w * bd) * (u * bf - w * bd) +
  (u * bg - x * bd) * (u * bg - x * bd) +
  (u * bh - y * bd) * (u * bh - y * bd) +
  (u * bi - z * bd) * (u * bi - z * bd) +
  (u * bj - aa * bd) * (u * bj - aa * bd) +
  (v * bf - w * be) * (v * bf - w * be) +
  (v * bg - x * be) * (v * bg - x * be) +
  (v * bh - y * be) * (v * bh - y * be) +
  (v * bi - z * be) * (v * bi - z * be) +
  (v * bj - aa * be) * (v * bj - aa * be) +
  (w * bg - x * bf) * (w * bg - x * bf) +
  (w * bh - y * bf) * (w * bh - y * bf) +
  (w * bi - z * bf) * (w * bi - z * bf) +
  (w * bj - aa * bf) * (w * bj - aa * bf) +
  (x * bh - y * bg) * (x * bh - y * bg) +
  (x * bi - z * bg) * (x * bi - z * bg) +
  (x * bj - aa * bg) * (x * bj - aa * bg) +
  (y * bi - z * bh) * (y * bi - z * bh) +
  (y * bj - aa * bh) * (y * bj - aa * bh) +
  (z * bj - aa * bi) * (z * bj - aa * bi)
}

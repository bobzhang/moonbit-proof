predicate in_bounds(xs : FixedArray[Int], i : Int) {
  (0 <= i) && (i < xs.length())
}

predicate sorted(xs : FixedArray[Int]) {
  ∀ i : Int, ∀ j : Int,
    ((in_bounds(xs, i)) && (in_bounds(xs, j)) && (i <= j)) →
      xs[i] <= xs[j]
}

predicate crosses_zero(xs : FixedArray[Int]) {
  (xs.length() > 0) && (xs[0] < 0) && (0 <= xs[xs.length() - 1])
}

predicate all_neg_before(xs : FixedArray[Int], idx : Int) {
  ∀ i : Int, ((0 <= i) && (i < idx)) → xs[i] < 0
}

predicate all_nonneg_from(xs : FixedArray[Int], idx : Int) {
  ∀ i : Int, ((idx <= i) && (i < xs.length())) → xs[i] >= 0
}

predicate neg_closest_zero(xs : FixedArray[Int], idx : Int) {
  ∀ k : Int, ((0 <= k) && (k < xs.length())) →
    (
      (0 <= idx) &&
      (idx < xs.length()) &&
      (xs[idx] < 0) &&
      ((xs[k] <= xs[idx]) || (-xs[idx] <= xs[k]))
    )
}

predicate nonneg_closest_zero(xs : FixedArray[Int], idx : Int) {
  ∀ k : Int, ((0 <= k) && (k < xs.length())) →
    (
      (0 <= idx) &&
      (idx < xs.length()) &&
      (xs[idx] >= 0) &&
      ((xs[k] <= -xs[idx]) || (xs[idx] <= xs[k]))
    )
}

predicate closest_zero_ok(xs : FixedArray[Int], idx : Int) {
  (neg_closest_zero(xs, idx)) || (nonneg_closest_zero(xs, idx))
}

predicate cauchy5_ok(
  a : Int,
  b : Int,
  c : Int,
  d : Int,
  e : Int,
  p : Int,
  q : Int,
  r : Int,
  s : Int,
  t : Int,
  result : Int
) {
  result ==
  (a * q - b * p) * (a * q - b * p) +
  (a * r - c * p) * (a * r - c * p) +
  (a * s - d * p) * (a * s - d * p) +
  (a * t - e * p) * (a * t - e * p) +
  (b * r - c * q) * (b * r - c * q) +
  (b * s - d * q) * (b * s - d * q) +
  (b * t - e * q) * (b * t - e * q) +
  (c * s - d * r) * (c * s - d * r) +
  (c * t - e * r) * (c * t - e * r) +
  (d * t - e * s) * (d * t - e * s)
}

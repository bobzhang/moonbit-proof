predicate in_bounds(xs : FixedArray[Int], i : Int) {
  (0 <= i) && (i < xs.length())
}

predicate sorted(xs : FixedArray[Int]) {
  ∀ i : Int, ∀ j : Int,
    ((in_bounds(xs, i)) && (in_bounds(xs, j)) && (i <= j)) →
      xs[i] <= xs[j]
}

predicate all_leq_before(xs : FixedArray[Int], key : Int, idx : Int) {
  ∀ i : Int, ((0 <= i) && (i < idx)) → xs[i] <= key
}

predicate all_greater_from(xs : FixedArray[Int], key : Int, idx : Int) {
  ∀ i : Int, ((idx <= i) && (i < xs.length())) → xs[i] > key
}

predicate predecessor_ok(xs : FixedArray[Int], key : Int, result : Int) {
  ((result == -1) && all_greater_from(xs, key, 0)) ||
  (
    (0 <= result) &&
    (result < xs.length()) &&
    all_leq_before(xs, key, result + 1) &&
    all_greater_from(xs, key, result + 1)
  )
}

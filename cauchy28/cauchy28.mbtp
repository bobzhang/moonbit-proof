  (r * be - u * bb) * (r * be - u * bb) +
  (r * bf - v * bb) * (r * bf - v * bb) +
  (r * bg - w * bb) * (r * bg - w * bb) +
  (r * bh - x * bb) * (r * bh - x * bb) +
  (r * bi - y * bb) * (r * bi - y * bb) +
  (r * bj - z * bb) * (r * bj - z * bb) +
  (r * bk - aa * bb) * (r * bk - aa * bb) +
  (r * bl - ab * bb) * (r * bl - ab * bb) +
  (s * bd - t * bc) * (s * bd - t * bc) +
  (s * be - u * bc) * (s * be - u * bc) +
  (s * bf - v * bc) * (s * bf - v * bc) +
  (s * bg - w * bc) * (s * bg - w * bc) +
  (s * bh - x * bc) * (s * bh - x * bc) +
  (s * bi - y * bc) * (s * bi - y * bc) +
  (s * bj - z * bc) * (s * bj - z * bc) +
  (s * bk - aa * bc) * (s * bk - aa * bc) +
  (s * bl - ab * bc) * (s * bl - ab * bc) +
  (t * be - u * bd) * (t * be - u * bd) +
  (t * bf - v * bd) * (t * bf - v * bd) +
  (t * bg - w * bd) * (t * bg - w * bd) +
  (t * bh - x * bd) * (t * bh - x * bd) +
  (t * bi - y * bd) * (t * bi - y * bd) +
  (t * bj - z * bd) * (t * bj - z * bd) +
  (t * bk - aa * bd) * (t * bk - aa * bd) +
  (t * bl - ab * bd) * (t * bl - ab * bd) +
  (u * bf - v * be) * (u * bf - v * be) +
  (u * bg - w * be) * (u * bg - w * be) +
  (u * bh - x * be) * (u * bh - x * be) +
  (u * bi - y * be) * (u * bi - y * be) +
  (u * bj - z * be) * (u * bj - z * be) +
  (u * bk - aa * be) * (u * bk - aa * be) +
  (u * bl - ab * be) * (u * bl - ab * be) +
  (v * bg - w * bf) * (v * bg - w * bf) +
  (v * bh - x * bf) * (v * bh - x * bf) +
  (v * bi - y * bf) * (v * bi - y * bf) +
  (v * bj - z * bf) * (v * bj - z * bf) +
  (v * bk - aa * bf) * (v * bk - aa * bf) +
  (v * bl - ab * bf) * (v * bl - ab * bf) +
  (w * bh - x * bg) * (w * bh - x * bg) +
  (w * bi - y * bg) * (w * bi - y * bg) +
  (w * bj - z * bg) * (w * bj - z * bg) +
  (w * bk - aa * bg) * (w * bk - aa * bg) +
  (w * bl - ab * bg) * (w * bl - ab * bg) +
  (x * bi - y * bh) * (x * bi - y * bh) +
  (x * bj - z * bh) * (x * bj - z * bh) +
  (x * bk - aa * bh) * (x * bk - aa * bh) +
  (x * bl - ab * bh) * (x * bl - ab * bh) +
  (y * bj - z * bi) * (y * bj - z * bi) +
  (y * bk - aa * bi) * (y * bk - aa * bi) +
  (y * bl - ab * bi) * (y * bl - ab * bi) +
  (z * bk - aa * bj) * (z * bk - aa * bj) +
  (z * bl - ab * bj) * (z * bl - ab * bj) +
  (aa * bl - ab * bk) * (aa * bl - ab * bk)
}

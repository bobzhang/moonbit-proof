predicate nonneg(n : Int) {
  n >= 0
}

predicate sum_tenth_powers_ok(n : Int, result : Int) {
  66 * result ==
  n * (n - 1) * (2 * n - 1) *
  (
    3 * n * n * n * n * n * n * n * n -
    12 * n * n * n * n * n * n * n +
    8 * n * n * n * n * n * n +
    18 * n * n * n * n * n -
    10 * n * n * n * n -
    24 * n * n * n +
    2 * n * n +
    15 * n +
    5
  )
}

predicate cauchy4_ok(
  a : Int,
  b : Int,
  c : Int,
  d : Int,
  w : Int,
  x : Int,
  y : Int,
  z : Int,
  result : Int
) {
  result ==
  (a * x - b * w) * (a * x - b * w) +
  (a * y - c * w) * (a * y - c * w) +
  (a * z - d * w) * (a * z - d * w) +
  (b * y - c * x) * (b * y - c * x) +
  (b * z - d * x) * (b * z - d * x) +
  (c * z - d * y) * (c * z - d * y)
}

  (c * aa - l * r) * (c * aa - l * r) +
  (c * ab - m * r) * (c * ab - m * r) +
  (c * ac - n * r) * (c * ac - n * r) +
  (c * ad - o * r) * (c * ad - o * r) +
  (d * t - e * s) * (d * t - e * s) +
  (d * u - f * s) * (d * u - f * s) +
  (d * v - g * s) * (d * v - g * s) +
  (d * w - h * s) * (d * w - h * s) +
  (d * x - i * s) * (d * x - i * s) +
  (d * y - j * s) * (d * y - j * s) +
  (d * z - k * s) * (d * z - k * s) +
  (d * aa - l * s) * (d * aa - l * s) +
  (d * ab - m * s) * (d * ab - m * s) +
  (d * ac - n * s) * (d * ac - n * s) +
  (d * ad - o * s) * (d * ad - o * s) +
  (e * u - f * t) * (e * u - f * t) +

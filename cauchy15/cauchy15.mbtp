  (b * ad - o * q) * (b * ad - o * q) +
  (c * s - d * r) * (c * s - d * r) +
  (c * t - e * r) * (c * t - e * r) +
  (c * u - f * r) * (c * u - f * r) +
  (c * v - g * r) * (c * v - g * r) +
  (c * w - h * r) * (c * w - h * r) +
  (c * x - i * r) * (c * x - i * r) +
  (c * y - j * r) * (c * y - j * r) +

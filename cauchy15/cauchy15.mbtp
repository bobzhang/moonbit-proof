  (e * ac - n * t) * (e * ac - n * t) +
  (e * ad - o * t) * (e * ad - o * t) +
  (f * v - g * u) * (f * v - g * u) +
  (f * w - h * u) * (f * w - h * u) +
  (f * x - i * u) * (f * x - i * u) +

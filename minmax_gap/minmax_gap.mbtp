predicate nonempty(xs : FixedArray[Int]) {
  xs.length() > 0
}

predicate lo_below_prefix(xs : FixedArray[Int], lo : Int, len : Int) {
  ∀ k : Int, ((0 <= k) && (k < len)) → lo <= xs[k]
}

predicate hi_above_prefix(xs : FixedArray[Int], hi : Int, len : Int) {
  ∀ k : Int, ((0 <= k) && (k < len)) → xs[k] <= hi
}

predicate minmax_gap_ok(xs : FixedArray[Int], result : Int) {
  ∀ i : Int, ∀ j : Int,
    ((0 <= i) && (i < xs.length()) && (0 <= j) && (j < xs.length())) →
      ((xs[i] - xs[j] <= result) && (result >= 0))
}

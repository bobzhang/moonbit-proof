predicate cauchy14_ok(
  a : Int,
  b : Int,
  c : Int,
  d : Int,
  e : Int,
  f : Int,
  g : Int,
  h : Int,
  i : Int,
  j : Int,
  k : Int,
  l : Int,
  m : Int,
  n : Int,
  o : Int,
  p : Int,
  q : Int,
  r : Int,
  s : Int,
  t : Int,
  u : Int,
  v : Int,
  w : Int,
  x : Int,
  y : Int,
  z : Int,
  aa : Int,
  ab : Int,
  result : Int
) {
  result ==
  (a * p - b * o) * (a * p - b * o) +
  (a * q - c * o) * (a * q - c * o) +
  (a * r - d * o) * (a * r - d * o) +
  (a * s - e * o) * (a * s - e * o) +
  (a * t - f * o) * (a * t - f * o) +
  (a * u - g * o) * (a * u - g * o) +
  (a * v - h * o) * (a * v - h * o) +
  (a * w - i * o) * (a * w - i * o) +
  (a * x - j * o) * (a * x - j * o) +
  (a * y - k * o) * (a * y - k * o) +
  (a * z - l * o) * (a * z - l * o) +
  (a * aa - m * o) * (a * aa - m * o) +
  (a * ab - n * o) * (a * ab - n * o) +
  (b * q - c * p) * (b * q - c * p) +
  (b * r - d * p) * (b * r - d * p) +
  (b * s - e * p) * (b * s - e * p) +
  (b * t - f * p) * (b * t - f * p) +
  (b * u - g * p) * (b * u - g * p) +
  (b * v - h * p) * (b * v - h * p) +
  (b * w - i * p) * (b * w - i * p) +
  (b * x - j * p) * (b * x - j * p) +
  (b * y - k * p) * (b * y - k * p) +
  (b * z - l * p) * (b * z - l * p) +
  (b * aa - m * p) * (b * aa - m * p) +
  (b * ab - n * p) * (b * ab - n * p) +
  (c * r - d * q) * (c * r - d * q) +
  (c * s - e * q) * (c * s - e * q) +
  (c * t - f * q) * (c * t - f * q) +
  (c * u - g * q) * (c * u - g * q) +
  (c * v - h * q) * (c * v - h * q) +
  (c * w - i * q) * (c * w - i * q) +
  (c * x - j * q) * (c * x - j * q) +
  (c * y - k * q) * (c * y - k * q) +
  (c * z - l * q) * (c * z - l * q) +
  (c * aa - m * q) * (c * aa - m * q) +
  (c * ab - n * q) * (c * ab - n * q) +
  (d * s - e * r) * (d * s - e * r) +
  (d * t - f * r) * (d * t - f * r) +
  (d * u - g * r) * (d * u - g * r) +
  (d * v - h * r) * (d * v - h * r) +
  (d * w - i * r) * (d * w - i * r) +
  (d * x - j * r) * (d * x - j * r) +
  (d * y - k * r) * (d * y - k * r) +
  (d * z - l * r) * (d * z - l * r) +
  (d * aa - m * r) * (d * aa - m * r) +
  (d * ab - n * r) * (d * ab - n * r) +
  (e * t - f * s) * (e * t - f * s) +
  (e * u - g * s) * (e * u - g * s) +
  (e * v - h * s) * (e * v - h * s) +
  (e * w - i * s) * (e * w - i * s) +
  (e * x - j * s) * (e * x - j * s) +
  (e * y - k * s) * (e * y - k * s) +
  (e * z - l * s) * (e * z - l * s) +
  (e * aa - m * s) * (e * aa - m * s) +
  (e * ab - n * s) * (e * ab - n * s) +
  (f * u - g * t) * (f * u - g * t) +
  (f * v - h * t) * (f * v - h * t) +
  (f * w - i * t) * (f * w - i * t) +
  (f * x - j * t) * (f * x - j * t) +
  (f * y - k * t) * (f * y - k * t) +
  (f * z - l * t) * (f * z - l * t) +
  (f * aa - m * t) * (f * aa - m * t) +
  (f * ab - n * t) * (f * ab - n * t) +
  (g * v - h * u) * (g * v - h * u) +
  (g * w - i * u) * (g * w - i * u) +
  (g * x - j * u) * (g * x - j * u) +
  (g * y - k * u) * (g * y - k * u) +
  (g * z - l * u) * (g * z - l * u) +
  (g * aa - m * u) * (g * aa - m * u) +
  (g * ab - n * u) * (g * ab - n * u) +
  (h * w - i * v) * (h * w - i * v) +
  (h * x - j * v) * (h * x - j * v) +
  (h * y - k * v) * (h * y - k * v) +
  (h * z - l * v) * (h * z - l * v) +
  (h * aa - m * v) * (h * aa - m * v) +
  (h * ab - n * v) * (h * ab - n * v) +
  (i * x - j * w) * (i * x - j * w) +
  (i * y - k * w) * (i * y - k * w) +
  (i * z - l * w) * (i * z - l * w) +
  (i * aa - m * w) * (i * aa - m * w) +
  (i * ab - n * w) * (i * ab - n * w) +
  (j * y - k * x) * (j * y - k * x) +
  (j * z - l * x) * (j * z - l * x) +
  (j * aa - m * x) * (j * aa - m * x) +
  (j * ab - n * x) * (j * ab - n * x) +
  (k * z - l * y) * (k * z - l * y) +
  (k * aa - m * y) * (k * aa - m * y) +
  (k * ab - n * y) * (k * ab - n * y) +
  (l * aa - m * z) * (l * aa - m * z) +
  (l * ab - n * z) * (l * ab - n * z) +
  (m * ab - n * aa) * (m * ab - n * aa)
}

  (z - aa) * (z - aa) +
  (z - ab) * (z - ab) +
  (z - ac) * (z - ac) +
  (z - ad) * (z - ad) +
  (z - ae) * (z - ae) +
  (z - af) * (z - af) +
  (z - ag) * (z - ag) +
  (z - ah) * (z - ah) +
  (aa - ab) * (aa - ab) +
  (aa - ac) * (aa - ac) +
  (aa - ad) * (aa - ad) +
  (aa - ae) * (aa - ae) +
  (aa - af) * (aa - af) +
  (aa - ag) * (aa - ag) +
  (aa - ah) * (aa - ah) +
  (ab - ac) * (ab - ac) +
  (ab - ad) * (ab - ad) +
  (ab - ae) * (ab - ae) +
  (ab - af) * (ab - af) +
  (ab - ag) * (ab - ag) +
  (ab - ah) * (ab - ah) +
  (ac - ad) * (ac - ad) +
  (ac - ae) * (ac - ae) +
  (ac - af) * (ac - af) +
  (ac - ag) * (ac - ag) +
  (ac - ah) * (ac - ah) +
  (ad - ae) * (ad - ae) +
  (ad - af) * (ad - af) +
  (ad - ag) * (ad - ag) +
  (ad - ah) * (ad - ah) +
  (ae - af) * (ae - af) +
  (ae - ag) * (ae - ag) +
  (ae - ah) * (ae - ah) +
  (af - ag) * (af - ag) +
  (af - ah) * (af - ah) +
  (ag - ah) * (ag - ah)
}

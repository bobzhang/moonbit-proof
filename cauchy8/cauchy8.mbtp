predicate cauchy8_ok(
  a : Int,
  b : Int,
  c : Int,
  d : Int,
  e : Int,
  f : Int,
  g : Int,
  h : Int,
  p : Int,
  q : Int,
  r : Int,
  s : Int,
  t : Int,
  u : Int,
  v : Int,
  w : Int,
  result : Int
) {
  result ==
  (a * q - b * p) * (a * q - b * p) +
  (a * r - c * p) * (a * r - c * p) +
  (a * s - d * p) * (a * s - d * p) +
  (a * t - e * p) * (a * t - e * p) +
  (a * u - f * p) * (a * u - f * p) +
  (a * v - g * p) * (a * v - g * p) +
  (a * w - h * p) * (a * w - h * p) +
  (b * r - c * q) * (b * r - c * q) +
  (b * s - d * q) * (b * s - d * q) +
  (b * t - e * q) * (b * t - e * q) +
  (b * u - f * q) * (b * u - f * q) +
  (b * v - g * q) * (b * v - g * q) +
  (b * w - h * q) * (b * w - h * q) +
  (c * s - d * r) * (c * s - d * r) +
  (c * t - e * r) * (c * t - e * r) +
  (c * u - f * r) * (c * u - f * r) +
  (c * v - g * r) * (c * v - g * r) +
  (c * w - h * r) * (c * w - h * r) +
  (d * t - e * s) * (d * t - e * s) +
  (d * u - f * s) * (d * u - f * s) +
  (d * v - g * s) * (d * v - g * s) +
  (d * w - h * s) * (d * w - h * s) +
  (e * u - f * t) * (e * u - f * t) +
  (e * v - g * t) * (e * v - g * t) +
  (e * w - h * t) * (e * w - h * t) +
  (f * v - g * u) * (f * v - g * u) +
  (f * w - h * u) * (f * w - h * u) +
  (g * w - h * v) * (g * w - h * v)
}

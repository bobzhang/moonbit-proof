predicate in_bounds(xs : FixedArray[Int], i : Int) {
  (0 <= i) && (i < xs.length())
}

predicate no_match_after(xs : FixedArray[Int], key : Int, found : Int, upto : Int) {
  ∀ k : Int, ((found < k) && (k < upto)) → xs[k] != key
}

predicate findlast_ok(xs : FixedArray[Int], key : Int, result : Int) {
  ((result == -1) ||
   ((in_bounds(xs, result)) && (xs[result] == key))) &&
  (no_match_after(xs, key, result, xs.length()))
}

predicate in_bounds(xs : FixedArray[Int], i : Int) {
  (0 <= i) && (i < xs.length())
}

predicate sorted(xs : FixedArray[Int]) {
  ∀ i : Int, ∀ j : Int,
    ((in_bounds(xs, i)) && (in_bounds(xs, j)) && (i <= j)) →
      xs[i] <= xs[j]
}

predicate strict_upto(xs : FixedArray[Int], len : Int) {
  ∀ k : Int, ((0 <= k) && (k + 1 < len)) → xs[k] < xs[k + 1]
}

predicate strict_when_unfound(xs : FixedArray[Int], found : Int, len : Int) {
  ∀ k : Int, ((0 <= k) && (k + 1 < len) && (found == -1)) → xs[k] < xs[k + 1]
}

predicate first_duplicate_ok(xs : FixedArray[Int], result : Int) {
  ((result == -1) && strict_upto(xs, xs.length())) ||
  (
    (0 <= result) &&
    (result + 1 < xs.length()) &&
    (xs[result] == xs[result + 1]) &&
    strict_upto(xs, result + 1)
  )
}

predicate has_peak(xs : FixedArray[Int]) {
  (xs.length() >= 3) && (xs[0] < xs[1]) && (xs[xs.length() - 2] > xs[xs.length() - 1])
}

predicate adjacent_distinct(xs : FixedArray[Int]) {
  ∀ i : Int, ((0 <= i) && (i + 1 < xs.length())) → xs[i] != xs[i + 1]
}

predicate rise_partition(xs : FixedArray[Int]) {
  ∀ i : Int, ∀ j : Int,
    ((0 <= i) && (i <= j) && (j + 1 < xs.length()) && (xs[j] < xs[j + 1])) →
      xs[i] < xs[i + 1]
}

predicate descent_partition(xs : FixedArray[Int]) {
  ∀ i : Int, ∀ j : Int,
    ((0 <= i) && (i <= j) && (j + 1 < xs.length()) && (xs[i] > xs[i + 1])) →
      xs[j] > xs[j + 1]
}

predicate rising_before(xs : FixedArray[Int], idx : Int) {
  ∀ i : Int, ((0 <= i) && (i < idx)) → xs[i] < xs[i + 1]
}

predicate descending_from(xs : FixedArray[Int], idx : Int) {
  ∀ i : Int, ((idx <= i) && (i + 1 < xs.length())) → xs[i] > xs[i + 1]
}

predicate mountain_peak_ok(xs : FixedArray[Int], result : Int) {
  (1 <= result) && (result + 1 < xs.length()) &&
  rising_before(xs, result) &&
  descending_from(xs, result)
}

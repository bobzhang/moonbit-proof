predicate in_bounds(xs : FixedArray[Int], i : Int) {
  (0 <= i) && (i < xs.length())
}

predicate sorted(xs : FixedArray[Int]) {
  ∀ i : Int, ∀ j : Int,
    ((in_bounds(xs, i)) && (in_bounds(xs, j)) && (i <= j)) →
      xs[i] <= xs[j]
}

predicate same_length(xs : FixedArray[Int], ys : FixedArray[Int]) {
  xs.length() == ys.length()
}

predicate nonempty(xs : FixedArray[Int]) {
  xs.length() > 0
}

predicate all_nonneg(ys : FixedArray[Int]) {
  ∀ i : Int, ((0 <= i) && (i < ys.length())) → ys[i] >= 0
}

predicate dot_lower_ok(result : Int) {
  result >= 0
}

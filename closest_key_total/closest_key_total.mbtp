predicate in_bounds(xs : FixedArray[Int], i : Int) {
  (0 <= i) && (i < xs.length())
}

predicate nonempty(xs : FixedArray[Int]) {
  xs.length() > 0
}

predicate sorted(xs : FixedArray[Int]) {
  ∀ i : Int, ∀ j : Int,
    ((in_bounds(xs, i)) && (in_bounds(xs, j)) && (i <= j)) →
      xs[i] <= xs[j]
}

predicate all_lt_before(xs : FixedArray[Int], key : Int, idx : Int) {
  ∀ i : Int, ((0 <= i) && (i < idx)) → xs[i] < key
}

predicate all_geq_from(xs : FixedArray[Int], key : Int, idx : Int) {
  ∀ i : Int, ((idx <= i) && (i < xs.length())) → xs[i] >= key
}

predicate left_closest(xs : FixedArray[Int], key : Int, idx : Int) {
  ∀ k : Int, ((0 <= k) && (k < xs.length())) →
    (
      (0 <= idx) &&
      (idx < xs.length()) &&
      (xs[idx] < key) &&
      ((xs[k] <= xs[idx]) || (2 * key - xs[idx] <= xs[k]))
    )
}

predicate right_closest(xs : FixedArray[Int], key : Int, idx : Int) {
  ∀ k : Int, ((0 <= k) && (k < xs.length())) →
    (
      (0 <= idx) &&
      (idx < xs.length()) &&
      (xs[idx] >= key) &&
      ((xs[k] <= 2 * key - xs[idx]) || (xs[idx] <= xs[k]))
    )
}

predicate closest_key_total_ok(xs : FixedArray[Int], key : Int, idx : Int) {
  (left_closest(xs, key, idx)) || (right_closest(xs, key, idx))
}

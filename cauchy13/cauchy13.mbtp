predicate cauchy13_ok(
  a : Int,
  b : Int,
  c : Int,
  d : Int,
  e : Int,
  f : Int,
  g : Int,
  h : Int,
  i : Int,
  j : Int,
  k : Int,
  l : Int,
  m : Int,
  n : Int,
  o : Int,
  p : Int,
  q : Int,
  r : Int,
  s : Int,
  t : Int,
  u : Int,
  v : Int,
  w : Int,
  x : Int,
  y : Int,
  z : Int,
  result : Int
) {
  result ==
  (a * o - b * n) * (a * o - b * n) +
  (a * p - c * n) * (a * p - c * n) +
  (a * q - d * n) * (a * q - d * n) +
  (a * r - e * n) * (a * r - e * n) +
  (a * s - f * n) * (a * s - f * n) +
  (a * t - g * n) * (a * t - g * n) +
  (a * u - h * n) * (a * u - h * n) +
  (a * v - i * n) * (a * v - i * n) +
  (a * w - j * n) * (a * w - j * n) +
  (a * x - k * n) * (a * x - k * n) +
  (a * y - l * n) * (a * y - l * n) +
  (a * z - m * n) * (a * z - m * n) +
  (b * p - c * o) * (b * p - c * o) +
  (b * q - d * o) * (b * q - d * o) +
  (b * r - e * o) * (b * r - e * o) +
  (b * s - f * o) * (b * s - f * o) +
  (b * t - g * o) * (b * t - g * o) +
  (b * u - h * o) * (b * u - h * o) +
  (b * v - i * o) * (b * v - i * o) +
  (b * w - j * o) * (b * w - j * o) +
  (b * x - k * o) * (b * x - k * o) +
  (b * y - l * o) * (b * y - l * o) +
  (b * z - m * o) * (b * z - m * o) +
  (c * q - d * p) * (c * q - d * p) +
  (c * r - e * p) * (c * r - e * p) +
  (c * s - f * p) * (c * s - f * p) +
  (c * t - g * p) * (c * t - g * p) +
  (c * u - h * p) * (c * u - h * p) +
  (c * v - i * p) * (c * v - i * p) +
  (c * w - j * p) * (c * w - j * p) +
  (c * x - k * p) * (c * x - k * p) +
  (c * y - l * p) * (c * y - l * p) +
  (c * z - m * p) * (c * z - m * p) +
  (d * r - e * q) * (d * r - e * q) +
  (d * s - f * q) * (d * s - f * q) +
  (d * t - g * q) * (d * t - g * q) +
  (d * u - h * q) * (d * u - h * q) +
  (d * v - i * q) * (d * v - i * q) +
  (d * w - j * q) * (d * w - j * q) +
  (d * x - k * q) * (d * x - k * q) +
  (d * y - l * q) * (d * y - l * q) +
  (d * z - m * q) * (d * z - m * q) +
  (e * s - f * r) * (e * s - f * r) +
  (e * t - g * r) * (e * t - g * r) +
  (e * u - h * r) * (e * u - h * r) +
  (e * v - i * r) * (e * v - i * r) +
  (e * w - j * r) * (e * w - j * r) +
  (e * x - k * r) * (e * x - k * r) +
  (e * y - l * r) * (e * y - l * r) +
  (e * z - m * r) * (e * z - m * r) +
  (f * t - g * s) * (f * t - g * s) +
  (f * u - h * s) * (f * u - h * s) +
  (f * v - i * s) * (f * v - i * s) +
  (f * w - j * s) * (f * w - j * s) +
  (f * x - k * s) * (f * x - k * s) +
  (f * y - l * s) * (f * y - l * s) +
  (f * z - m * s) * (f * z - m * s) +
  (g * u - h * t) * (g * u - h * t) +
  (g * v - i * t) * (g * v - i * t) +
  (g * w - j * t) * (g * w - j * t) +
  (g * x - k * t) * (g * x - k * t) +
  (g * y - l * t) * (g * y - l * t) +
  (g * z - m * t) * (g * z - m * t) +
  (h * v - i * u) * (h * v - i * u) +
  (h * w - j * u) * (h * w - j * u) +
  (h * x - k * u) * (h * x - k * u) +
  (h * y - l * u) * (h * y - l * u) +
  (h * z - m * u) * (h * z - m * u) +
  (i * w - j * v) * (i * w - j * v) +
  (i * x - k * v) * (i * x - k * v) +
  (i * y - l * v) * (i * y - l * v) +
  (i * z - m * v) * (i * z - m * v) +
  (j * x - k * w) * (j * x - k * w) +
  (j * y - l * w) * (j * y - l * w) +
  (j * z - m * w) * (j * z - m * w) +
  (k * y - l * x) * (k * y - l * x) +
  (k * z - m * x) * (k * z - m * x) +
  (l * z - m * y) * (l * z - m * y)
}
